---
// Grid de tecnologías (ADR-005):
//  - Los datos viven en ../content/tech.ts (nombre, categoría, nivel, nota, icono).
//  - Los botones filtran por categoría (isla JS mínima; sin JS se ven todas).
//  - Al pasar el cursor o enfocar un item se revela su nivel y una nota.
import { TECH, TECH_CATEGORIES, type TechItem } from '../content/tech';
import { TECH_ICONS } from '../content/tech-icons';
import type { Locale } from '../i18n/util';
import { getDictionary } from '../i18n/util';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

// Devuelve el icono de simple-icons o `undefined` (se usará un monograma).
function getIcon(item: TechItem) {
  return item.icon ? TECH_ICONS[item.icon] : undefined;
}
---

<div class="tech" data-tech-grid>
  <!-- Filtros por categoría (solo visibles si hay JS: se controla con la clase .js) -->
  <div class="tech-filters" role="group" aria-label={t['tech.filterLabel']}>
    <button class="tech-chip is-active" type="button" data-filter="all" aria-pressed="true">
      {t['tech.all']}
    </button>
    {TECH_CATEGORIES.map((cat) => (
      <button class="tech-chip" type="button" data-filter={cat} aria-pressed="false">
        {t[`cat.${cat}` as keyof typeof t]}
      </button>
    ))}
  </div>

  <!-- Items; `data-category` alimenta el filtrado y `tabindex` da acceso por teclado -->
  <ul class="tech-grid" role="list" data-reveal-stagger>
    {TECH.map((item) => {
      const icon = getIcon(item);
      const note = locale === 'es' ? item.note_es : item.note_en;
      // Monograma de reserva si no hay icono de marca (p. ej. Java, ServiceNow).
      const monogram = item.name.replace(/[^A-Za-z0-9]/g, '').slice(0, 2).toUpperCase();
      return (
        <li class="tech-item" data-category={item.category} tabindex="0">
          <span class="tech-icon" style={icon ? `--brand: #${icon.hex}` : undefined} aria-hidden="true">
            {icon ? (
              <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" role="img">
                <path d={icon.path} />
              </svg>
            ) : (
              <span class="tech-monogram">{monogram}</span>
            )}
          </span>
          <span class="tech-name">{item.name}</span>
          <!-- Panel que aparece al hover/focus con nivel + nota -->
          <span class="tech-reveal">
            <span class:list={['tech-level', `level-${item.level}`]}>
              {t[`level.${item.level}` as keyof typeof t]}
            </span>
            <span class="tech-note">{note}</span>
          </span>
        </li>
      );
    })}
  </ul>

  <p class="tech-hint text-muted">{t['tech.hoverHint']}</p>
</div>

<!-- Isla JS: filtra los items por categoría al pulsar un botón -->
<script>
  document.querySelectorAll<HTMLElement>('[data-tech-grid]').forEach((grid) => {
    const buttons = grid.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = grid.querySelectorAll<HTMLElement>('[data-category]');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? 'all';
        // Marca el botón activo (estado visual + aria-pressed para accesibilidad).
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
        // Muestra/oculta items según la categoría elegida.
        items.forEach((item) => {
          item.hidden = !(filter === 'all' || item.dataset.category === filter);
        });
      });
    });
  });
</script>

<style>
  .tech {
    display: grid;
    gap: var(--space-5);
  }

  .tech-filters {
    display: none;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  :global(.js) .tech-filters {
    display: flex;
  }

  .tech-chip {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .tech-chip:hover {
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .tech-chip.is-active {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    color: var(--color-accent-hover);
    font-weight: 600;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13.5rem), 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tech-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: default;
    transition:
      border-color var(--transition-base),
      background-color var(--transition-base),
      transform var(--transition-base);
  }

  .tech-item:hover,
  .tech-item:focus-visible {
    border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
    background: var(--color-surface-hover);
    transform: translateY(-2px);
    z-index: 2;
  }

  .tech-item:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .tech-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: color var(--transition-base);
  }

  .tech-item:hover .tech-icon,
  .tech-item:focus-visible .tech-icon {
    color: var(--brand, var(--color-accent));
  }

  .tech-monogram {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .tech-name {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
  }

  .tech-reveal {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
    padding: var(--space-3) var(--space-4);
    background: color-mix(in srgb, var(--color-bg-elevated) 92%, transparent);
    backdrop-filter: blur(6px);
    border-radius: inherit;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--transition-base),
      visibility var(--transition-base);
    pointer-events: none;
  }

  .tech-item:hover .tech-reveal,
  .tech-item:focus-visible .tech-reveal {
    opacity: 1;
    visibility: visible;
  }

  .tech-level {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .level-advanced {
    color: var(--color-success);
  }

  .level-intermediate {
    color: var(--color-accent-hover);
  }

  .level-basic {
    color: var(--color-text-muted);
  }

  .level-learning {
    color: var(--color-warning);
  }

  .tech-note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.35;
  }

  .tech-hint {
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }
</style>
