---
// Cabecera fija (sticky) con el nombre, la navegación a las secciones y el
// conmutador de idioma ES/EN.
import { getLocaleFromPath, getDictionary } from '../i18n/util';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getDictionary(locale);

const path = Astro.url.pathname;
const isEn = path === '/en' || path.startsWith('/en/');
// Ruta de la home en el idioma actual; los anclas se prefijan con ella para que
// funcionen también desde las páginas de detalle de proyecto.
const homeHref = isEn ? '/en/' : '/';

const links = [
  { href: `${homeHref}#proyectos`, label: t['nav.projects'] },
  { href: `${homeHref}#sobre-mi`, label: t['nav.about'] },
  { href: `${homeHref}#contacto`, label: t['nav.contact'] },
];

// Enlace a la misma página en el otro idioma (quita/añade el prefijo /en).
const otherHref = isEn ? (path.replace(/^\/en/, '') || '/') : `/en${path === '/' ? '/' : path}`;
// Etiqueta del enlace al otro idioma (ES ↔ EN).
const otherLang = isEn ? 'ES' : 'EN';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeHref}>
      <span class="brand-dot" aria-hidden="true"></span>
      {t['hero.name']}
    </a>
    <!-- Navegación principal; el último item es el cambio de idioma -->
    <nav aria-label={locale === 'es' ? 'Principal' : 'Main'}>
      <ul class="nav-list">
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li>
          <a class="lang-switch" href={otherHref} hreflang={isEn ? 'es' : 'en'}>{otherLang}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    height: 100%;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-base);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
    transition: opacity var(--transition-fast);
  }

  .brand:hover {
    opacity: 0.85;
  }

  .brand-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: var(--radius-full);
    background: var(--gradient-accent);
    box-shadow: 0 0 12px var(--color-accent-glow);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .nav-list a {
    position: relative;
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
  }

  .nav-list a:not(.lang-switch)::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.35rem;
    width: 100%;
    height: 1.5px;
    background: var(--gradient-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-base);
  }

  .nav-list a:not(.lang-switch):hover {
    color: var(--color-text);
  }

  .nav-list a:not(.lang-switch):hover::after {
    transform: scaleX(1);
  }

  .lang-switch {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    transition:
      border-color var(--transition-fast),
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .lang-switch:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
    background: var(--color-accent-soft);
  }

  @media (max-width: 640px) {
    .nav-list {
      gap: var(--space-3);
    }

    .nav-list li:not(:last-child) {
      display: none;
    }
  }
</style>
