---
import Base from '../layouts/Base.astro';
import { getLocaleFromPath, getDictionary } from '../i18n/util';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getDictionary(locale);
---

<Base>
  <section id="inicio" class="hero container">
    <p class="hero-role">{t['hero.role']}</p>
    <h1>{t['hero.name']}</h1>
    <p class="hero-tagline">{t['hero.tagline']}</p>
    <div class="hero-ctas">
      <a class="btn" href="#proyectos">{t['hero.cta.projects']}</a>
      <a class="btn btn-ghost" href="#contacto">{t['hero.cta.contact']}</a>
    </div>
  </section>

  <section id="proyectos" class="container section-placeholder">
    <h2>{t['projects.title']}</h2>
    <p>{t['projects.subtitle']}</p>
  </section>

  <section id="sobre-mi" class="container section-placeholder">
    <h2>{t['about.title']}</h2>
  </section>

  <section id="contacto" class="container section-placeholder">
    <h2>{t['contact.title']}</h2>
    <p>{t['contact.subtitle']}</p>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100vh - 4rem);
    gap: 1rem;
    padding-block: 4rem;
  }

  .hero-role {
    color: var(--color-accent, #6366f1);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.875rem;
  }

  h1 {
    font-size: clamp(2.5rem, 8vw, 5rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .hero-tagline {
    max-width: 40rem;
    color: rgba(244, 244, 245, 0.7);
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .btn {
    padding: 0.7rem 1.4rem;
    border-radius: 0.6rem;
    background: var(--color-accent, #6366f1);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    transition: transform 150ms ease, opacity 150ms ease;
  }

  .btn:hover {
    transform: translateY(-2px);
    opacity: 0.92;
  }

  .btn-ghost {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .section-placeholder {
    padding-block: 5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  h2 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }
</style>
