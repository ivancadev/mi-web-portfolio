---
// Página de inicio completa. Sirve para ES (/) y EN (/en/) porque el idioma
// se deduce de la URL. Estructura: Hero + Proyectos + Sobre mí + Contacto.
import Base from '../layouts/Base.astro';
import Button from './base/Button.astro';
import Badge from './base/Badge.astro';
import ProjectsSection from './ProjectsSection.astro';
import AboutSection from './AboutSection.astro';
import ContactSection from './ContactSection.astro';
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getProfileImage } from '../lib/profile-assets';
import { getLocaleFromPath, getDictionary } from '../i18n/util';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getDictionary(locale);

const profile = await getEntry('profile', 'profile');
const photo = profile ? getProfileImage(profile.data.photo) : undefined;
---

<Base>
  <!-- Hero: primera impresión. El glow y la cuadrícula son decorativos (aria-hidden) -->
  <section id="inicio" class="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-glow"></div>
      <div class="hero-grid"></div>
    </div>

        <div class="container hero-inner">
      <div class="hero-content">
        <p class="eyebrow">{t['hero.role']}</p>
        <h1 class="hero-title">
          Iván <span class="gradient-text">Cano</span>
        </h1>
        <p class="hero-tagline">{t['hero.tagline']}</p>

        <div class="hero-badges">
          <Badge tone="accent">{locale === 'es' ? 'SDD · Spec-first' : 'SDD · Spec-first'}</Badge>
          <Badge tone="learning">{locale === 'es' ? 'Docker · K8s · AWS' : 'Docker · K8s · AWS'}</Badge>
          <Badge tone="success">Cisco CCST Cybersecurity</Badge>
        </div>

        <div class="hero-ctas">
          <Button href="#proyectos">{t['hero.cta.projects']}</Button>
          <Button href="#contacto" variant="outline">{t['hero.cta.contact']}</Button>
        </div>
      </div>

      <figure class="hero-photo">
        <img
          src="/mi-foto.jpg"
          alt="Iván Cano"
          width="240"
          height="240"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- Secciones montadas como componentes independientes (cada una lee el contenido) -->
  <ProjectsSection locale={locale} />

  <AboutSection locale={locale} />

  <ContactSection locale={locale} />
</Base>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: clip;
    min-height: calc(100vh - var(--header-height));
    padding-block: var(--space-8);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-glow {
    position: absolute;
    top: -20%;
    left: 50%;
    translate: -50% 0;
    width: min(60rem, 120vw);
    aspect-ratio: 1.6;
    background: radial-gradient(
      ellipse at center,
      var(--color-accent-glow) 0%,
      transparent 62%
    );
    filter: blur(30px);
    opacity: 0.55;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 30%, #000 30%, transparent 75%);
  }

  .hero-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-7);
    flex-wrap: wrap;
    padding-block: var(--space-6);
  }

  .hero-content {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    max-width: 48rem;
  }

  .hero-photo {
    flex-shrink: 0;
  }

  .hero-photo img {
    width: clamp(160px, 22vw, 240px);
    height: clamp(160px, 22vw, 240px);
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    box-shadow: 0 10px 80px -20px rgba(96, 165, 250, 0.45);
    border: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
  }

  @media (max-width: 720px) {
    .hero-inner {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
      gap: var(--space-6);
    }

    .hero-content {
      justify-items: center;
    }

    .hero-badges,
    .hero-ctas {
      justify-content: center;
    }

    .hero-tagline {
      margin-inline: auto;
    }
  }

  .hero-title {
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
  }

  .hero-tagline {
    max-width: 38rem;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
</style>
